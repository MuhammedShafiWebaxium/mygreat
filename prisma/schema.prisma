generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum PartnerRole {
  PARTNER_ADMIN
  ADMISSIONS_EXECUTIVE
  VISA_EXECUTIVE
  RECEPTION_EXECUTIVE

  @@map("partner_role")
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("partner_status")
}

enum AdminRole {
  SUPER_ADMIN
  MARKETING_EXECUTIVE
  FINANCE_EXECUTIVE
  SUPPORT_EXECUTIVE

  @@map("admin_role")
}

enum ApplicationStatus {
  SOP_PREPARATION
  SOP_VERIFICATION
  SOP_CORRECTION_REQUIRED
  SOP_APPROVED
  APPLICATION_SUBMISSION
  APPLICATION_ACCEPTED
  APPLICATION_FOLLOW_UP
  CONDITIONAL_OFFER_RECEIVED
  UNCONDITIONAL_OFFER_RECEIVED
  MOVE_TO_VISA

  @@map("application_status")
}

enum OfferType {
  CONDITIONAL
  UNCONDITIONAL

  @@map("offer_type")
}

enum VisaStatus {
  MEET_OFFER_CONDITIONS
  TUITION_FEE_PAYMENT
  VISA_DOCUMENT_COLLECTION
  VISA_SERVICE_CHARGE
  VISA_SLOT_BOOKING
  VISA_LEVEL_1_VERIFICATION
  VISA_LEVEL_2_VERIFICATION
  VISA_SUBMISSION
  VISA_APPROVED
  VISA_REAPPLY_OR_APPEAL
  VISA_GRANTED

  @@map("visa_status")
}

enum DocumentStatus {
  NEEDED
  PENDING
  VERIFIED
  REJECTED

  @@map("document_status")
}

enum DeadlineType {
  APPLICATION
  EXAM
  DEPOSIT
  HOUSING
  VISA
  TASK

  @@map("deadline_type")
}

enum NotificationKind {
  OFFER
  DOCUMENT
  DEADLINE
  MESSAGE
  SYSTEM

  @@map("notification_kind")
}

model Student {
  id                    String        @id @default(uuid()) @db.Uuid
  name                  String
  email                 String        @unique(map: "students_email_unique")
  phone                 String?
  passwordHash          String        @map("password_hash")
  emailVerifiedAt       DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions              StudentSession[]
  profile               StudentProfile?
  shortlist             StudentShortlist[]
  applications          Application[] @relation("StudentApplications")
  tasks                 Task[]
  documents             Document[]    @relation("StudentDocuments")
  deadlines             Deadline[]
  notifications         Notification[]
  workflowFollowups     WorkflowFollowup[]
  assignedPartnerCompanyId String?      @map("assigned_partner_company_id") @db.Uuid
  assignedPartnerCompany   PartnerCompany? @relation(fields: [assignedPartnerCompanyId], references: [id], onDelete: SetNull)

  @@index([assignedPartnerCompanyId], map: "students_partner_company_idx")
  @@map("students")
}

model Partner {
  id                    String        @id @default(uuid()) @db.Uuid
  name                  String
  email                 String        @unique(map: "partners_email_unique")
  phone                 String?
  passwordHash          String        @map("password_hash")
  role                  PartnerRole
  partnerCompanyId      String        @map("partner_company_id") @db.Uuid
  emailVerifiedAt       DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  active                Boolean       @default(true)
  mustChangePassword    Boolean       @default(false) @map("must_change_password")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions              PartnerSession[]
  admissionsAssignments Application[] @relation("AdmissionsAssignments")
  visaAssignments       Application[] @relation("VisaAssignments")
  verifiedDocuments     Document[]    @relation("VerifiedDocuments")
  partnerCompany        PartnerCompany @relation(fields: [partnerCompanyId], references: [id], onDelete: Cascade)

  @@index([role], map: "partners_role_idx")
  @@index([partnerCompanyId], map: "partners_company_idx")
  @@map("partners")
}

model PartnerCompany {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String
  registrationNumber String        @unique(map: "partner_companies_registration_unique") @map("registration_number")
  website            String?
  address            String
  country            String
  contactName        String             @map("contact_name")
  contactEmail       String        @unique(map: "partner_companies_contact_email_unique") @map("contact_email")
  contactPhone       String             @map("contact_phone")
  status             PartnerStatus @default(PENDING)
  reviewNote         String?            @map("review_note")
  reviewedBy         String?            @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  credentialsSentAt  DateTime?          @map("credentials_sent_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  partners           Partner[]
  assignedStudents   Student[]

  @@index([status, createdAt], map: "partner_companies_status_idx")
  @@map("partner_companies")
}

model Admin {
  id              String         @id @default(uuid()) @db.Uuid
  name            String
  email           String         @unique(map: "admins_email_unique")
  phone           String?
  passwordHash    String         @map("password_hash")
  role            AdminRole
  emailVerifiedAt DateTime?      @map("email_verified_at") @db.Timestamptz(6)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions        AdminSession[]

  @@index([role], map: "admins_role_idx")
  @@map("admins")
}

model StudentSession {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  tokenHash  String   @unique(map: "sessions_token_hash_unique") @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId], map: "student_sessions_student_idx")
  @@index([expiresAt], map: "student_sessions_expiry_idx")
  @@map("student_sessions")
}

model PartnerSession {
  id         String   @id @default(uuid()) @db.Uuid
  partnerId  String   @map("partner_id") @db.Uuid
  tokenHash  String   @unique(map: "partner_sessions_token_hash_unique") @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId], map: "partner_sessions_partner_idx")
  @@index([expiresAt], map: "partner_sessions_expiry_idx")
  @@map("partner_sessions")
}

model AdminSession {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  tokenHash  String   @unique(map: "admin_sessions_token_hash_unique") @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "admin_sessions_admin_idx")
  @@index([expiresAt], map: "admin_sessions_expiry_idx")
  @@map("admin_sessions")
}

model StudentProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique(map: "student_profiles_user_unique") @map("user_id") @db.Uuid
  destinationCountry    Json?     @map("destination_country")
  educationLevel        String    @default("") @map("education_level")
  degree                String    @default("")
  field                 String    @default("")
  gpa                   Decimal?  @db.Decimal(3, 2)
  graduationYear        String    @default("") @map("graduation_year")
  englishTest           String    @default("") @map("english_test")
  preferredIntake       String    @default("") @map("preferred_intake")
  openToRecommendations Boolean   @default(false) @map("open_to_recommendations")
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  Student   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

model University {
  id           String             @id @default(uuid())
  name         String
  city         String
  countryId    String             @map("country_id") @db.Uuid
  rank         Int                @default(0) // Legacy primary rank; use rankings for named ranking systems.
  website      String?
  tuition      String
  acceptance   String
  knownFor     String             @map("known_for")
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  shortlists   StudentShortlist[]
  applications Application[]
  country      Country            @relation(fields: [countryId], references: [id], onDelete: Restrict)
  courses      Course[]
  rankings     UniversityRanking[]

  @@index([countryId], map: "universities_country_idx")
  @@index([rank], map: "universities_rank_idx")
  @@map("universities")
}

model UniversityRanking {
  id           String     @id @default(uuid()) @db.Uuid
  universityId String     @map("university_id")
  name         String
  value        String
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, name])
  @@index([universityId])
  @@map("university_rankings")
}

model Country {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  code         String       @unique @db.VarChar(3)
  currencyCode String       @map("currency_code") @db.VarChar(3)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  universities University[]

  @@map("countries")
}

model Course {
  id           String       @id @default(uuid()) @db.Uuid
  universityId String       @map("university_id")
  name         String
  code         String
  level        String
  durationMonths Int        @map("duration_months")
  campus          String     @default("")
  intakeMonth     String[]   @default([]) @map("intake_month")
  intakeYear      String     @default("") @map("intake_year")
  tuitionFee      String     @default("") @map("tuition_fee")
  ranking         String     @default("")
  ielts           String     @default("")
  ieltsMin        String     @default("") @map("ielts_min")
  toefl           String     @default("")
  toeflMin        String     @default("") @map("toefl_min")
  pte             String     @default("")
  pteMin          String     @default("") @map("pte_min")
  applicationDeadline String @default("") @map("application_deadline")
  scholarshipAvailable String @default("") @map("scholarship_available")
  requirements    String     @default("")
  backlogRange    String     @default("") @map("backlog_range")
  remarks         String     @default("")
  applicationMode String     @default("") @map("application_mode")
  englishProficiency String   @default("") @map("english_proficiency")
  entryRequirements String   @default("") @map("entry_requirements")
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  university   University   @relation(fields: [universityId], references: [id], onDelete: Cascade)
  fees         CourseFee[]
  applications Application[]

  @@index([universityId])
  @@map("courses")
}

model CourseFee {
  id            String   @id @default(uuid()) @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  currencyCode  String   @map("currency_code") @db.VarChar(3)
  effectiveFrom DateTime @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, effectiveFrom])
  @@map("course_fees")
}

model StudentShortlist {
  userId       String     @map("user_id") @db.Uuid
  universityId String     @map("university_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user         Student    @relation(fields: [userId], references: [id], onDelete: Cascade)
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@id([userId, universityId])
  @@map("student_shortlists")
}

model Application {
  id                    String            @id @default(uuid()) @db.Uuid
  studentId             String            @map("student_id") @db.Uuid
  universityId          String            @map("university_id")
  program               String
  courseId              String?           @map("course_id") @db.Uuid
  quotedFeeAmount       Decimal?          @map("quoted_fee_amount") @db.Decimal(12, 2)
  quotedFeeCurrency     String?           @map("quoted_fee_currency") @db.VarChar(3)
  feeQuotedAt           DateTime?         @map("fee_quoted_at") @db.Timestamptz(6)
  progress              Int               @default(0)
  nextAction            String            @default("Complete your application") @map("next_action")
  isPriority            Boolean           @default(false) @map("is_priority")
  applicationStage      ApplicationStatus @default(SOP_PREPARATION) @map("application_stage")
  offerType             OfferType?        @map("offer_type")
  applicationDeadline   DateTime?         @map("application_deadline") @db.Date
  admissionsExecutiveId String?           @map("admissions_executive_id") @db.Uuid
  visaExecutiveId       String?           @map("visa_executive_id") @db.Uuid
  submittedAt           DateTime?         @map("submitted_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  student               Student           @relation("StudentApplications", fields: [studentId], references: [id], onDelete: Cascade)
  university            University        @relation(fields: [universityId], references: [id])
  course                Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  admissionsExecutive   Partner?          @relation("AdmissionsAssignments", fields: [admissionsExecutiveId], references: [id], onDelete: SetNull)
  visaExecutive         Partner?          @relation("VisaAssignments", fields: [visaExecutiveId], references: [id], onDelete: SetNull)
  tasks                 Task[]
  documents             Document[]
  deadlines             Deadline[]
  visaAttempts          VisaAttempt[]
  workflowFollowups     WorkflowFollowup[]
  workflowApprovals     WorkflowApprovalRequest[]
  offerLetter           ApplicationOfferLetter?

  @@index([studentId], map: "applications_student_idx")
  @@index([admissionsExecutiveId], map: "applications_admissions_idx")
  @@index([visaExecutiveId], map: "applications_visa_idx")
  @@map("applications")
}

/// A distinct visa journey for an application. Reapplications create another attempt.
model VisaAttempt {
  id                String                    @id @default(uuid()) @db.Uuid
  applicationId     String                    @map("application_id") @db.Uuid
  attemptNumber     Int                       @map("attempt_number")
  isCurrent         Boolean                   @default(false) @map("is_current")
  currentStage      VisaStatus                @default(MEET_OFFER_CONDITIONS) @map("current_stage")
  outcome           String?
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  application       Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  followups         WorkflowFollowup[]
  approvalRequests  WorkflowApprovalRequest[]

  @@unique([applicationId, attemptNumber])
  @@index([applicationId, createdAt(sort: Desc)], map: "visa_attempts_application_idx")
  @@map("visa_attempts")
}

model ApplicationOfferLetter {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @unique(map: "application_offer_letters_application_id_key") @map("application_id") @db.Uuid
  offerType     OfferType   @map("offer_type")
  fileName      String      @map("file_name")
  mimeType      String      @map("mime_type")
  sizeBytes     Int         @map("size_bytes")
  fileData      Bytes       @map("file_data")
  uploadedById  String      @map("uploaded_by_id") @db.Uuid
  uploadedByName String     @map("uploaded_by_name")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_offer_letters")
}

/// Immutable event history for application and visa workflow actions.
model WorkflowFollowup {
  id                      String                    @id @default(uuid()) @db.Uuid
  studentId               String                    @map("student_id") @db.Uuid
  applicationId           String                    @map("application_id") @db.Uuid
  visaAttemptId           String?                   @map("visa_attempt_id") @db.Uuid
  workflowType            String                    @map("workflow_type")
  stage                   String
  outcome                 String?
  notes                   String                    @default("")
  expectedCompletionAt    DateTime?                 @map("expected_completion_at") @db.Timestamptz(6)
  expectedCompletionEndAt DateTime?                 @map("expected_completion_end_at") @db.Timestamptz(6)
  nextFollowUpAt          DateTime?                 @map("next_follow_up_at") @db.Timestamptz(6)
  assignedStaffId         String?                   @map("assigned_staff_id") @db.Uuid
  assignedStaffName       String?                   @map("assigned_staff_name")
  createdById             String                    @map("created_by_id") @db.Uuid
  createdByName           String                    @map("created_by_name")
  followedUpAt            DateTime                  @default(now()) @map("followed_up_at") @db.Timestamptz(6)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  student                 Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  application             Application               @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  visaAttempt             VisaAttempt?              @relation(fields: [visaAttemptId], references: [id], onDelete: Cascade)
  attachments             WorkflowFollowupFile[]
  approvalRequest         WorkflowApprovalRequest?

  @@index([applicationId, workflowType, followedUpAt(sort: Desc), id(sort: Desc)], map: "workflow_followups_application_idx")
  @@index([visaAttemptId, followedUpAt(sort: Desc), id(sort: Desc)], map: "workflow_followups_visa_idx")
  @@index([studentId, followedUpAt(sort: Desc)], map: "workflow_followups_student_idx")
  @@map("workflow_followups")
}

model WorkflowFollowupFile {
  id          String           @id @default(uuid()) @db.Uuid
  followupId  String           @map("followup_id") @db.Uuid
  fileName    String           @map("file_name")
  mimeType    String           @map("mime_type")
  sizeBytes   Int              @map("size_bytes")
  fileData    Bytes            @map("file_data")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  followup    WorkflowFollowup @relation(fields: [followupId], references: [id], onDelete: Cascade)

  @@index([followupId], map: "workflow_followup_files_followup_id_idx")
  @@map("workflow_followup_files")
}

model WorkflowApprovalRequest {
  id              String           @id @default(uuid()) @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  applicationId   String           @map("application_id") @db.Uuid
  followupId      String           @unique(map: "workflow_approval_requests_followup_id_key") @map("followup_id") @db.Uuid
  workflowType    String           @default("APPLICATION") @map("workflow_type")
  visaAttemptId   String?          @map("visa_attempt_id") @db.Uuid
  stage           String
  status          String           @default("PENDING")
  requestedById   String           @map("requested_by_id") @db.Uuid
  requestedByName String           @map("requested_by_name")
  reviewedById    String?          @map("reviewed_by_id") @db.Uuid
  reviewedByName  String?          @map("reviewed_by_name")
  reviewNote      String?          @map("review_note")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  followup        WorkflowFollowup @relation(fields: [followupId], references: [id], onDelete: Cascade)
  visaAttempt     VisaAttempt?     @relation(fields: [visaAttemptId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "workflow_approval_requests_pending_idx")
  @@index([visaAttemptId], map: "workflow_approval_requests_visa_attempt_id_idx")
  @@map("workflow_approval_requests")
}

model Task {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  applicationId String?      @map("application_id") @db.Uuid
  label         String
  dueDate       DateTime?    @map("due_date") @db.Date
  tag           String       @default("General")
  completed     Boolean      @default(false)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          Student      @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId], map: "tasks_user_idx")
  @@map("tasks")
}

model Document {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  applicationId String?        @map("application_id") @db.Uuid
  name          String
  status        DocumentStatus @default(NEEDED)
  note          String         @default("")
  storageKey    String?        @map("storage_key")
  verifiedBy    String?        @map("verified_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          Student        @relation("StudentDocuments", fields: [userId], references: [id], onDelete: Cascade)
  application   Application?   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifier      Partner?       @relation("VerifiedDocuments", fields: [verifiedBy], references: [id], onDelete: SetNull)

  @@index([userId], map: "documents_user_idx")
  @@map("documents")
}

model Deadline {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  applicationId String?      @map("application_id") @db.Uuid
  label         String
  organization  String
  dueDate       DateTime     @map("due_date") @db.Date
  type          DeadlineType
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          Student      @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate], map: "deadlines_user_date_idx")
  @@map("deadlines")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  kind        NotificationKind @default(SYSTEM)
  title       String
  description String
  readAt      DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user        Student          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt], map: "notifications_user_idx")
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId], map: "audit_logs_actor_idx")
  @@index([entityType, entityId], map: "audit_logs_entity_idx")
  @@map("audit_logs")
}

model CatalogImportJob {
  id            String               @id @default(uuid()) @db.Uuid
  actorId       String               @map("actor_id") @db.Uuid
  entityType    String               @map("entity_type")
  fileName      String               @map("file_name")
  totalRows     Int                  @default(0) @map("total_rows")
  processedRows Int                  @default(0) @map("processed_rows")
  createdRows   Int                  @default(0) @map("created_rows")
  updatedRows   Int                  @default(0) @map("updated_rows")
  skippedRows   Int                  @default(0) @map("skipped_rows")
  failedRows    Int                  @default(0) @map("failed_rows")
  status        String               @default("PROCESSING")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt   DateTime?            @map("completed_at") @db.Timestamptz(6)
  errors        CatalogImportError[]

  @@index([actorId, createdAt], map: "catalog_import_jobs_actor_created_idx")
  @@map("catalog_import_jobs")
}

model CatalogImportError {
  id        String           @id @default(uuid()) @db.Uuid
  jobId     String           @map("job_id") @db.Uuid
  rowNumber Int              @map("row_number")
  message   String
  rowData   Json             @map("row_data")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  job       CatalogImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, rowNumber], map: "catalog_import_errors_job_row_idx")
  @@map("catalog_import_errors")
}
